# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=lab_management

# JWT Configuration
# Generate a secure key in production (minimum 32 characters)
JWT_SECRET=super_secret_lab_management_jwt_key_at_least_32_bytes_long_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL for CORS (comma separated if multiple)
FRONTEND_URL=http://localhost:5173
